{
  "appName": "RICR-HIM-1011 AI Career & Interview Prep Platform",
  "domain": "AI Job-Resume Matching, Skill Gap Analysis & Mock Interview Platform",
  "models": {
    "User": {
      "file": "server/src/features/user/user.model.js",
      "fields": {
        "fullName": "String (required, trim)",
        "email": "String (required, unique, lowercase, trim)",
        "password": "String (required, hashed)",
        "timestamps": "createdAt, updatedAt"
      },
      "relationships": "Has many Jobs, Resumes, Analyses, Interviews"
    },
    "OTP": {
      "file": "server/src/features/auth/otp.model.js",
      "fields": {
        "email": "String (required, unique)",
        "otp": "String (required)",
        "expiresAt": "Date (TTL 10 mins)"
      },
      "relationships": "Linked via email during authentication/verification"
    },
    "Job": {
      "file": "server/src/features/job/job.model.js",
      "fields": {
        "userId": "ObjectId -> User (required)",
        "title": "String (required, trim)",
        "description": "String (required, trim)",
        "timestamps": "createdAt, updatedAt"
      },
      "relationships": "Belongs to User; referenced by Analysis and Interview"
    },
    "Resume": {
      "file": "server/src/features/resume/resume.model.js",
      "fields": {
        "userId": "ObjectId -> User (required)",
        "fileName": "String (required)",
        "extractedText": "String (required)",
        "parsedData": {
          "name": "String",
          "email": "String",
          "phone": "String",
          "summary": "String",
          "skills": "[String]",
          "experience": "[{ company, position, startDate, endDate, description }]",
          "education": "[{ institution, degree, field, startDate, endDate }]",
          "projects": "[{ name, description, technologies: [String] }]",
          "certifications": "[{ name, issuer, date }]"
        },
        "timestamps": "createdAt, updatedAt"
      },
      "relationships": "Belongs to User; referenced by Analysis and Interview"
    },
    "Analysis": {
      "file": "server/src/features/analysis/analysis.model.js",
      "fields": {
        "userId": "ObjectId -> User (required)",
        "resumeId": "ObjectId -> Resume (required)",
        "jobId": "ObjectId -> Job (required)",
        "matchScore": "Number (0-100, required)",
        "matchedSkills": "[String]",
        "missingSkills": "[String]",
        "suggestions": "[String]",
        "summary": "String",
        "timestamps": "createdAt, updatedAt"
      },
      "relationships": "Links User, Resume, and Job for match feedback & gap analysis"
    },
    "Interview": {
      "file": "server/src/features/interview/interview.model.js",
      "fields": {
        "userId": "ObjectId -> User (required)",
        "resumeId": "ObjectId -> Resume (required)",
        "jobId": "ObjectId -> Job (required)",
        "questions": [
          {
            "question": "String (required)",
            "answer": "String (default empty)",
            "feedback": "String (default empty)",
            "score": "Number (0-100)",
            "type": "Enum ['technical', 'behavioral']"
          }
        ],
        "overallScore": "Number (0-100)",
        "summary": "String (default empty)",
        "status": "Enum ['in-progress', 'completed'] (default 'in-progress')",
        "timestamps": "createdAt, updatedAt"
      },
      "relationships": "Links User, Resume, and Job for interactive Q&A and scoring"
    }
  },
  "userFlows": [
    {
      "flow": "Auth & Verification",
      "screens": ["Login", "Register", "OTP Verification"]
    },
    {
      "flow": "Job & Resume Management",
      "screens": ["Job Description Upload/Form", "Resume Upload & Parsed Viewer"]
    },
    {
      "flow": "Match & Skill Analysis",
      "screens": ["Match Score Dashboard", "Skill Gap & Suggestions Breakdown"]
    },
    {
      "flow": "Interactive Mock Interview",
      "screens": ["Interview Setup", "Interactive Q&A Session (Technical & Behavioral)", "Interview Performance & Summary Scorecard"]
    }
  ]
}
